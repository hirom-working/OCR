<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.yourname.scansnap-watcher</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/yourname/Projects/OCR/watch_scansnap.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/yourname/Library/Logs/scansnap_watcher.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/yourname/Library/Logs/scansnap_watcher.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/yourname/Projects/OCR</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
</dict>
</plist>
